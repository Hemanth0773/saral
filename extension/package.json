{
  "name": "saral-browser-copilot",
  "private": true,
  "version": "2.4.0",
  "type": "module",
  "description": "Saral — Browser Copilot. Chrome extension that simplifies government notices and official webpages using the Saral FastAPI backend.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src vite.config.ts vite.scripts.config.ts",
    "build:popup": "vite build",
    "build:scripts": "vite build --config vite.scripts.config.ts --mode background && vite build --config vite.scripts.config.ts --mode content",
    "build": "npm run typecheck && npm run build:popup && npm run build:scripts",
    "test": "node --import ./scripts/register-ts.mjs --test \"src/__tests__/*.test.ts\"",
    "verify:backend": "node --import ./scripts/register-ts.mjs scripts/verify-backend.mjs",
    "verify:scholarship": "node --import ./scripts/register-ts.mjs scripts/verify-scholarship.mjs",
    "verify:dist": "node scripts/verify-dist.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
