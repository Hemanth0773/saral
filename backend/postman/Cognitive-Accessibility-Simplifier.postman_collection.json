{
  "info": {
    "name": "Cognitive Accessibility Simplifier API",
    "description": "API for simplifying complex government documents into accessible content. Supports multiple LLM providers: OpenAI, Google Gemini (free tier), and others. Configure via backend/.env",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health & Status",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/api/health",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "health"]
            },
            "description": "Check if the API is running and healthy"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Document Processing (Milestone 2+)",
      "item": [
        {
          "name": "Extract PDF",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "<path-to-pdf-file>"
                }
              ]
            },
            "url": {
              "raw": "http://localhost:8000/api/documents/extract",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "documents", "extract"]
            },
            "description": "Extract text from an uploaded PDF document"
          },
          "response": []
        },
        {
          "name": "Extract from URL",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://example.gov.in/scheme\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/documents/url",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "documents", "url"]
            },
            "description": "Extract text from a government webpage URL"
          },
          "response": []
        }
      ]
    },
    {
      "name": "NLP Preprocessing (Milestone 4)",
      "item": [
        {
          "name": "Preprocess Text",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"The Government of India launched a new housing assistance scheme. The deadline is 31 December 2026.\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/documents/preprocess",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "documents", "preprocess"]
            },
            "description": "Apply NLP preprocessing: normalization, sentence segmentation, entity extraction, and key phrase extraction"
          },
          "response": []
        }
      ]
    },
    {
      "name": "LLM Simplification (Milestone 5)",
      "item": [
        {
          "name": "Simplify Text - Basic Example",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"The applicant shall submit the duly completed application form along with the requisite supporting documentation prior to the prescribed deadline.\",\n  \"target_grade_level\": 5\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/documents/simplify",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "documents", "simplify"]
            },
            "description": "Simplify complex government document text to make it more accessible while preserving all critical factual information"
          },
          "response": []
        },
        {
          "name": "Simplify Text - With Critical Facts",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Eligible applicants must submit the application before 31 December 2026. The assistance amount is ₹2,50,000. Applicants must be at least 18 years old and must submit Aadhaar card, income certificate, and bank account details.\",\n  \"target_grade_level\": 5\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/documents/simplify",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "documents", "simplify"]
            },
            "description": "Simplify text containing critical facts (dates, money, ages, requirements). These facts must be preserved exactly.\n\nCRITICAL FACTS TO PRESERVE:\n- Deadline: 31 December 2026\n- Amount: ₹2,50,000\n- Age: 18 years\n- Required documents: Aadhaar, income certificate, bank account details"
          },
          "response": []
        },
        {
          "name": "Validate Fact Preservation",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/api/documents/simplify/validate?original_text=Apply before 31 December 2026. Amount is ₹2,50,000.&simplified_text=You must apply by 31 December 2026. You will get ₹2,50,000.",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "documents", "simplify", "validate"],
              "query": [
                {
                  "key": "original_text",
                  "value": "Apply before 31 December 2026. Amount is ₹2,50,000.",
                  "type": "string"
                },
                {
                  "key": "simplified_text",
                  "value": "You must apply by 31 December 2026. You will get ₹2,50,000.",
                  "type": "string"
                }
              ]
            },
            "description": "Validate that critical factual information is preserved between original and simplified text. Checks for dates, amounts, ages, percentages, and other critical facts."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Translation (Milestone 9+)",
      "item": [
        {
          "name": "Translate Text",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"This is a simple government message about housing assistance.\",\n  \"source_language\": \"en\",\n  \"target_language\": \"kn\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/translate",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "translate"]
            },
            "description": "Translate simplified text to a regional language"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Text-to-Speech (Milestone 10+)",
      "item": [
        {
          "name": "Generate Audio",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"This is a simple government message.\",\n  \"language\": \"en\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/tts",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "tts"]
            },
            "description": "Generate audio (TTS) from simplified text"
          },
          "response": []
        }
      ]
    }
  ]
}
