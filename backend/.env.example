# Application Settings
APP_NAME=Cognitive Accessibility Simplifier
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# CORS Settings
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000", "http://127.0.0.1:3000"]

# File Upload Settings
MAX_FILE_SIZE_MB=10
MAX_FILENAME_LENGTH=255
UPLOAD_DIRECTORY=uploads
GENERATED_DIRECTORY=generated

# Document Processing
MAX_DOCUMENT_LENGTH=100000
CHUNK_SIZE=2000

# Simplification Settings
MAX_SIMPLIFICATION_ATTEMPTS=2
TARGET_GRADE_LEVEL=5

# LLM Configuration (Choose one provider)
# For OpenAI:
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-your-api-key-here
# LLM_MODEL=gpt-3.5-turbo
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=2000

# LLM Configuration
LLM_PROVIDER=auto
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2000
#Provider fallback: Gemini -> Groq -> OpenRouter

# Rate-limit handling (optional, these are the defaults)
# Rounds of provider attempts for one chunk. A 429 is retried after the
# delay the provider asked for instead of failing the whole document.
# LLM_MAX_RETRIES=3
# LLM_RETRY_BASE_DELAY=2.0
# LLM_RETRY_MAX_DELAY=60.0
# LLM_RETRY_JITTER=0.25
# LLM_SIMPLIFICATION_TIMEOUT=240

# For Google Gemini:
# LLM_PROVIDER=gemini
# LLM_API_KEY=your-gemini-api-key-here
# LLM_MODEL=gemini-2.5-flash
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=2000

# ==============================
# Groq
# ==============================
#GROQ_API_KEY=your-groq-api-key-here
#GROQ_MODEL=openai/gpt-oss-20b

# ==============================
# OpenRouter
# ==============================
#OPENROUTER_API_KEY=your-openrouter-api-key-here
#OPENROUTER_MODEL=openai/gpt-oss-20b

# For Anthropic:
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-your-api-key-here
# LLM_MODEL=claude-3-sonnet-20240229

# For local Hugging Face (FUTURE):
# LLM_PROVIDER=huggingface
# LLM_MODEL=meta-llama/Llama-2-7b-chat-hf

# Translation Configuration
TRANSLATION_PROVIDER=nllb
TRANSLATION_API_KEY=

# TTS Configuration (MILESTONE 10)
# Uses Microsoft Edge TTS (free, no API key required)
TTS_PROVIDER=edge-tts
TTS_API_KEY=

# URL Fetching (MILESTONE 2)
URL_FETCH_TIMEOUT=10
URL_FETCH_MAX_SIZE=10485760

# Document Processing
DOCUMENT_ID_PREFIX=doc

# Database Configuration (MILESTONE 11)
# PostgreSQL connection string
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
# For local development without a password (trust auth), use empty password:
# DATABASE_URL=postgresql+psycopg://postgres:@127.0.0.1:5432/cognitive_accessibility_db
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@127.0.0.1:5432/cognitive_accessibility_db
USE_DATABASE=true

# Logging
LOG_LEVEL=INFO
